# Adresse de l'API Jeuncy.
#
# Le suffixe /api est OBLIGATOIRE : Laravel prefixe automatiquement toutes les
# routes declarees dans routes/api.php. L'oublier casse silencieusement tous
# les appels (c'est le bug qui avait touche le frontend web en phase 2).
#
# Laisse cette ligne commentee pour viser la production, qui est le defaut.
# EXPO_PUBLIC_API_URL=https://api.jeuncy.com/api

# Pour viser un Laravel lance sur le PC, remplace l'adresse par l'IP locale du
# PC (jamais localhost : depuis le telephone, localhost designe le telephone).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api
