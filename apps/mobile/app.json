{
  "expo": {
    "name": "Jeuncy",
    "slug": "jeuncy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jeuncy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jeuncy.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jeuncy.app",
      "adaptiveIcon": {
        "backgroundColor": "#061D4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION"],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061D4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jeuncy utilise ta position pour te proposer les offres les plus proches de toi. Les recruteurs ne la voient jamais.",
          "locationWhenInUsePermission": "Jeuncy utilise ta position pour te proposer les offres les plus proches de toi. Les recruteurs ne la voient jamais.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jeuncy accède à tes photos uniquement quand tu choisis une photo de profil ou le logo de ton entreprise.",
          "cameraPermission": "Jeuncy utilise l'appareil photo uniquement quand tu prends ta photo de profil ou le logo de ton entreprise.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "jeuncy-app",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "270a7fed-698d-4587-8a17-369d540cbdb9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/270a7fed-698d-4587-8a17-369d540cbdb9"
    }
  }
}
