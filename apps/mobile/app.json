{
  "expo": {
    "name": "Jeuncy",
    "slug": "jeuncy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jeuncy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jeuncy.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.jeuncy.app",
      "adaptiveIcon": {
        "backgroundColor": "#061D4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061D4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jeuncy utilise ta position pour te proposer les offres les plus proches de toi. Les recruteurs ne la voient jamais.",
          "locationWhenInUsePermission": "Jeuncy utilise ta position pour te proposer les offres les plus proches de toi. Les recruteurs ne la voient jamais.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
