<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- 128 Mo (le defaut du CLI) ne suffisent plus : la suite depasse
             800 tests, et le rendu dompdf de CvthequeDownloadTest tombe en
             « Premature end of PHP process » quand il arrive en fin de
             parcours avec la memoire deja bien remplie. Le test passe seul,
             ce qui rend la panne difficile a lire — d'ou cette ligne plutot
             qu'un memory_limit a se rappeler sur la ligne de commande.
             Mesure du 2026-09-23 : 844 tests passent a 1 Go. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- MAIL_MAILER=array ne suffit pas : MailService n'utilise pas le
             mailer Laravel, il appelle l'API HTTP de Resend directement. Sans
             cette ligne, la suite lisait la vraie cle du .env et partait
             joindre api.resend.com a chaque test touchant un envoi (essai
             gratuit, candidature, rappel de visio) — appels reseau reels,
             quota consomme, et risque d'envoi si une adresse de test etait
             routable. Cle vide = MailService journalise au lieu d'envoyer
             (voir le garde-fou en tete de chacune de ses methodes). -->
        <env name="RESEND_API_KEY" value=""/>
        <!-- Meme logique pour Stripe : aucun test ne doit pouvoir creer une
             session de paiement reelle. Les services construisent leur client
             a la demande, un secret vide les fait echouer bruyamment plutot
             que d'agir sur le vrai compte. -->
        <env name="STRIPE_SECRET_KEY" value=""/>
        <!-- Les tests du modele payant (essai, abonnement, Stripe, CVtheque
             verrouillee) tournent avec la gratuite ETEINTE : ce code reste
             en place pour pouvoir rouvrir une grille tarifaire, il doit donc
             rester verifie. Le mode gratuit, celui de la production, est
             teste explicitement dans ModeGratuitTest. -->
        <env name="JEUNCY_GRATUIT" value="false"/>
        <env name="JEUNCY_INSCRIPTION_CFA_OUVERTE" value="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
