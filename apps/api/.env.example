APP_NAME=Jeuncy
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de donnees MySQL (le dev tourne contre une vraie instance, ex. Clever
# Cloud DEV plan gratuit — voir CLAUDE.md section "Base de donnees de dev")
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jeuncy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Deploiement split-folder sans SSH (hebergement mutualise OVH, voir CLAUDE.md
# section 11 "Base de donnees de dev" / "Bascule NestJS -> Laravel") : le
# dossier public/ est deploye a part de l'app (<site>-app a cote de <site> a la
# racine FTP), donc public_path() ne resout plus rien d'utile a l'interieur de
# l'app privee. Laisser vide en local (public/ reste dans l'app, chemins par
# defaut corrects) ; en staging/prod, definir le chemin absolu vers le dossier
# public reel sur le serveur.
# PUBLIC_STORAGE_PATH : dossier storage/ web-accessible (ex: /home/xxx/<site>-public/storage)
PUBLIC_STORAGE_PATH=
# DOMPDF_PUBLIC_PATH : dossier public/ lui-meme (ex: /home/xxx/<site>-public),
# requis par barryvdh/laravel-dompdf pour generer le CV PDF - sans ca la
# generation de CV echoue en 500 ("Cannot resolve public path")
DOMPDF_PUBLIC_PATH=

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@jeuncy.fr"
MAIL_FROM_NAME="${APP_NAME}"

# URL du frontend (apps/web), utilisee pour les liens dans les emails et les
# redirections OAuth/Stripe
FRONTEND_URL=http://localhost:5173

# JWT (access token courte duree, JSON + refresh token longue duree, cookie
# httpOnly) — generer des secrets aleatoires uniques en local, ex:
# php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL_MINUTES=15
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_MINUTES=10080

# Google OAuth (connexion candidat/entreprise) — optionnel en local, laisser
# vide pour desactiver ce mode de connexion
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Stripe (offres payantes) — cles de test depuis le dashboard Stripe
# (dashboard.stripe.com/test/apikeys), le webhook secret est fourni par
# `stripe listen` en local ou par la configuration du endpoint en production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix fixe de publication d'une offre SEULE (sans acces aux candidatures),
# en centimes, different entreprise/CFA (tarifs amenes a evoluer, dernier
# ajustement le 2026-08-06)
STRIPE_COMPANY_OFFER_PRICE_CENTS=999
STRIPE_CFA_OFFER_PRICE_CENTS=599
# Deblocage ponctuel de l'acces aux candidatures d'une offre precise
# Abonnement mensuel : publication illimitee + acces candidatures inclus
STRIPE_COMPANY_SUBSCRIPTION_PRICE_CENTS=49900
STRIPE_CFA_SUBSCRIPTION_PRICE_CENTS=49900
STRIPE_FOUNDER_SUBSCRIPTION_PRICE_CENTS=29900
STRIPE_FOUNDER_SEATS_TOTAL=50

# Resend (emails transactionnels) — laisser vide pour logger les emails au
# lieu de les envoyer (voir App\Services\MailService)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@jeuncy.com

VITE_APP_NAME="${APP_NAME}"

# Deploiement sans acces SSH (hebergement mutualise) : laisser vide en local
# et en dev. En production, definir temporairement une valeur aleatoire longue
# (ex: php -r "echo bin2hex(random_bytes(24));") pour activer /deploy/{token}/status
# et /deploy/{token}/migrate le temps d'appliquer les migrations, puis la
# remettre a vide.
DEPLOY_TOKEN=

# Coordonnees affichees sur la page Contact (CONTACT_PHONE vide = bloc masque)
CONTACT_EMAIL=bonjour@jeuncy.com
CONTACT_PHONE=
