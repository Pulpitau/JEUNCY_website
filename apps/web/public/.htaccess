# Ce fichier est copie tel quel dans dist/ a chaque build (voir vite.config.ts,
# publicDir par defaut = public/) : il est donc automatiquement present a
# chaque redeploiement, contrairement au Basic Auth de staging (.htpasswd) qui
# lui doit rester ajoute a la main sur le serveur (specifique a staging, ne
# doit pas se retrouver dans le build de production).

# --- Forcer HTTPS ---------------------------------------------------------
# Le site repondait en clair sur http://jeuncy.com sans rediriger : un
# visiteur tapant "jeuncy.com" pouvait saisir son mot de passe sur une page
# non chiffree, et Google risquait d'indexer une version HTTP en double.
#
# DEUX conditions, et non une seule : selon la configuration du proxy OVH,
# c'est %{HTTPS} ou l'en-tete X-Forwarded-Proto qui porte l'information. En
# n'agissant que si les DEUX indiquent une requete non chiffree, on ne peut
# pas boucler — si l'une des deux dit "https", aucune redirection.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Un seul domaine canonique : jeuncy.com, sans "www" ----------------
  # www.jeuncy.com servait la meme application, mais l API n autorise que
  # https://jeuncy.com en CORS (FRONTEND_URL cote serveur). Resultat : un
  # visiteur arrivant sur www voyait le site s afficher normalement et
  # AUCUN appel API ne fonctionnait — pas d offres, pas de connexion, sans
  # le moindre message d erreur. Constate en production le 2026-09-02.
  #
  # Rediriger plutot qu elargir l allowlist CORS : deux domaines servant le
  # meme contenu divisent aussi le referencement, et la balise canonical de
  # index.html designe deja l apex.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# --- En-tetes de securite -------------------------------------------------
<IfModule mod_headers.c>
  # Impose HTTPS pendant 6 mois apres la premiere visite : le navigateur
  # n'essaiera meme plus le HTTP. Duree volontairement pas maximale et sans
  # "preload" : ces deux options sont difficiles a annuler si un probleme de
  # certificat survenait.
  Header always set Strict-Transport-Security "max-age=15768000"

  # Empeche le navigateur de "deviner" un type de fichier : une image piegee
  # ne peut pas etre interpretee comme du script.
  Header always set X-Content-Type-Options "nosniff"

  # Empeche l'affichage du site dans une iframe tierce (clickjacking : un
  # faux site superpose des boutons invisibles sur le vrai).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Ne transmet pas l'URL complete aux sites externes, seulement le domaine.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Cache : le document d'entree doit toujours etre frais -----------------
# index.html designe les fichiers d'assets par leur empreinte. Servi depuis le
# cache, il fait charger au navigateur l'ANCIEN bundle — qui existe toujours
# sur le serveur, rien n'y est jamais supprime — et le visiteur execute une
# version perimee du site sans qu'aucune erreur ne le signale.
#
# Constate le 2026-09-10 : une page d'administration restait blanche apres
# correctif deploye, parce que l'onglet ouvert executait encore le bundle
# precedent. Aggravant, c'est une application monopage : naviguer vers une
# autre page ne redemande NI le HTML NI le JavaScript. OVH ne posait aucun
# Cache-Control sur le HTML (verifie : ni ETag, ni Last-Modified non plus),
# laissant le navigateur decider seul.
# OVH active mod_expires par defaut : il ajoute son propre Cache-Control
# (max-age=900) et un Expires APRES les notres, ce qui produit deux
# directives max-age contradictoires dans une meme reponse. La norme laisse
# alors le comportement a l appreciation de chaque navigateur — autant dire
# que la regle immuable ci-dessous ne serait pas fiable. On coupe donc
# mod_expires et on pilote le cache uniquement par mod_headers.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # A l'inverse, un fichier de build porte son empreinte dans son nom
  # (index-uRdQ6uug.js) : son contenu ne changera jamais, une nouvelle version
  # a un autre nom. Un an de cache immuable est donc exact, et bien plus
  # rapide que les 900 secondes par defaut d'OVH.
  #
  # Le motif exige le tiret et l'empreinte : favicon.ico et les logos, qui NE
  # sont PAS empreintes, gardent le cache par defaut et restent donc
  # remplacables.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Les fichiers NON empreintes (favicon, logos, robots.txt, sitemap) :
  # une heure. Assez pour soulager le serveur, assez court pour qu un
  # remplacement se propage dans la journee.
  <FilesMatch "\.(ico|png|jpe?g|svg|webp|woff2?|txt|xml)$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# --- Routage de l'application monopage ------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
