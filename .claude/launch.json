{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@jeuncy/web", "dev"],
      "port": 5173
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@jeuncy/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=3000"],
      "port": 3000,
      "cwd": "apps/api"
    }
  ]
}
